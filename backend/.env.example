# JOURNI Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# .env is NOT committed to version control

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# Required for AI features (preference interpretation, explanation, refinement)
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.5-flash
# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL (production / development):
DATABASE_URL=postgresql+psycopg2://journi:123456@localhost:5432/journi

# SQLite (local testing only — set this instead of DATABASE_URL to use SQLite):
# DATABASE_URL=sqlite:///./journi.db

# ─── Planner timing ──────────────────────────────────────────────────────────
# Buffers are applied by the backend scheduler; journey times entered by users remain unchanged.
JOURNI_ARRIVAL_BUFFER_MINUTES=60
JOURNI_DEPARTURE_BUFFER_MINUTES=60
JOURNI_DAY_END=22:00
# Places farther than this from the selected destination center are excluded from local planning.
JOURNI_MAX_PLACE_DISTANCE_KM=150
JOURNI_RECOMMENDATION_CAR_RADIUS_KM=10
JOURNI_RECOMMENDATION_EVENING_CAR_RADIUS_KM=7
JOURNI_RECOMMENDATION_TAXI_RADIUS_KM=12
JOURNI_RECOMMENDATION_PUBLIC_RADIUS_KM=8
JOURNI_RECOMMENDATION_WALKING_RADIUS_KM=5
JOURNI_RECOMMENDATION_DEFAULT_RADIUS_KM=8

# ─── Notes ────────────────────────────────────────────────────────────────────
# To set up PostgreSQL locally:
#   1. Install PostgreSQL 16+ (https://www.postgresql.org/download/)
#   2. Create user:    CREATE USER journi WITH PASSWORD '123456';
#   3. Create DB:      CREATE DATABASE journi OWNER journi;
#   4. Run migrations: cd backend && alembic upgrade head
#   5. Load data:      cd backend && python scripts/data/load_to_postgres.py
